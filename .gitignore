# dependencies
node_modules/
.pnpm-store/

# python (offline oracle tooling — never in CI)
.venv/
__pycache__/
*.egg-info/
uv.lock

# build output
dist/
*.tsbuildinfo

# OCCT / WASM build artifacts. The kernel .wasm IS committed (owner ruling 2026-07-12): it is only
# ~4 MB, the OCCT build id pins it so it changes rarely, and committing it means Amer and CI get real
# geometry without a 2.5 h toolchain build. The recipe that produces it is tools/kernel-build/; the
# artifact itself lives with the package that ships it, @bunyan/kernel-occt.
*.wasm
!packages/kernel-occt/wasm/*.wasm
!tests/fixtures/**/*.wasm

# scratch output of tools/kernel-build/link.sh (the committed copy is wasm/, not dist/)
tools/kernel-build/dist/

# local
.DS_Store
*.log
.env
.env.local

# Claude Code: launch.json (the shared dev-server config) IS committed; settings.local.json is
# per-machine permissions and must not be.
.claude/settings.local.json

# `pnpm test` writes this so `pnpm state` can report the real suite count instead of a
# hand-typed number. Build artifact, never committed.
.vitest-summary.json
.migration-manifest.json
