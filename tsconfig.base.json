{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": ".",
    "paths": {
      "@bunyan/protocol": ["packages/protocol/src/index.ts"],
      "@bunyan/kernel-core": ["packages/kernel-core/src/index.ts"],
      "@bunyan/kernel-mock": ["packages/kernel-mock/src/index.ts"],
      "@bunyan/kernel-client": ["packages/kernel-client/src/index.ts"]
    }
  }
}
