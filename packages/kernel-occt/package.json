{
  "name": "@bunyan/kernel-occt",
  "version": "0.0.0",
  "private": true,
  "description": "The real geometry kernel: upstream OCCT 7.9.3 compiled to WebAssembly, behind the Bunyan protocol.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts",
    "./wasm": "./wasm/bunyan-kernel.js"
  },
  "files": [
    "src",
    "wasm"
  ],
  "scripts": {
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@bunyan/kernel-core": "workspace:*",
    "@bunyan/protocol": "workspace:*"
  }
}
